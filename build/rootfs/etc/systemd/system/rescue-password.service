[Unit]
Description=cloud-rescue: optional password from the instance metadata (rescue_pass)
After=cloud-init.service cloud-config.service
Before=cloud-final.service
ConditionPathExists=/run/cloud-init

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/rescue-password
RemainAfterExit=yes

[Install]
WantedBy=cloud-init.target
