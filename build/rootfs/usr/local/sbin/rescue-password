#!/usr/bin/env bash
# rescue-password: optional password for the `rescue` user, read from the instance metadata
# (cloud-rescue, openimages.cloud). Runs at every boot, after cloud-init.
#
#   OpenStack: openstack server set --property rescue_pass='...' my-server
#              (or the admin password of `openstack server rescue --password`, when the
#              cloud uses a config drive)
#
# With a password: it is set on `rescue`, and SSH accepts it in addition to the key.
# Without one: `rescue` is locked again and SSH stays key-only.
set -euo pipefail

USER_NAME=rescue
SSHD_DROPIN=/etc/ssh/sshd_config.d/10-rescue-password.conf
DATA=/run/cloud-init/instance-data-sensitive.json

pass=""
if [[ -r "$DATA" ]]; then
  pass=$(python3 - "$DATA" <<'PY'
import json, sys
try:
    md = json.load(open(sys.argv[1])).get("ds", {}).get("meta_data", {}) or {}
except Exception:
    md = {}
meta = md.get("meta") or {}
value = meta.get("rescue_pass") or md.get("admin_pass") or ""
print(value if isinstance(value, str) else "", end="")
PY
)
fi

id "$USER_NAME" >/dev/null 2>&1 || { echo "rescue-password: no user $USER_NAME"; exit 0; }

if [[ -n "$pass" ]]; then
  printf '%s:%s\n' "$USER_NAME" "$pass" | chpasswd
  printf '%s\n' "# Written by rescue-password: a rescue_pass is set in the instance metadata." \
    "PasswordAuthentication yes" "KbdInteractiveAuthentication yes" >"$SSHD_DROPIN"
  echo "rescue-password: password set for $USER_NAME from the metadata, SSH password login enabled"
else
  passwd -l "$USER_NAME" >/dev/null
  rm -f "$SSHD_DROPIN"
  echo "rescue-password: no rescue_pass in the metadata, SSH key only"
fi
# --no-block: during boot sshd may not be started yet; never wait on its job.
systemctl --no-block try-reload-or-restart sshd.service || true
